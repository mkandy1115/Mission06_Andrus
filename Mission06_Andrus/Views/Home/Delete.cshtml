@{
}

@model Mission06_Andrus.Models.RealMovie

<h1>Confirm Deleting the following Movie</h1>
<h3>Movie Title: @Model.Title</h3>
<h3>Year: @Model.Year </h3>
<form method="post">

    <input type="hidden" asp-for="MovieId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-info" asp-controller="Home" asp-action="MovieList">Cancel</a>

</form>
